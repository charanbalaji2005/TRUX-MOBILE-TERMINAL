# Maintainer: Charan Balaji <charanbalaji@meridian.dev>
pkgname=meridian-terminal
pkgver=2.0.0
pkgrel=1
pkgdesc="Modern Linux Terminal & Unified Developer Environment"
arch=('x86_64' 'aarch64')
url="https://github.com/charanbalaji2005/Meridian-Shell"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
makedepends=('gcc' 'make' 'cmake')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    make all
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 build/meridian-shell "$pkgdir/usr/bin/meridian-shell"
    install -Dm755 build/meridian "$pkgdir/usr/bin/meridian"
    install -Dm644 meridian.desktop "$pkgdir/usr/share/applications/meridian.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

